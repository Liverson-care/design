// PackAI Designer — schéma de données PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  company       String?
  plan          Plan      @default(FREE)
  designsUsed   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  projects    Project[]
  generations Generation[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Gabarit normalisé (dimensions, panneaux, découpes, plis) — jamais modifié par la génération
  dieline   Json
  /// Réponses au questionnaire
  brief     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designs Design[]

  @@index([userId])
}

model Design {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  style       String
  /// Scène vectorielle complète (éléments, palette, typographies)
  scene       Json
  /// Résultat du contrôle "Mode GMS France"
  gmsReport   Json?
  /// Identifiant de gamme : les déclinaisons partagent le même rangeId
  rangeId     String?
  isValidated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([rangeId])
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  count     Int
  usedAi    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Tables NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
