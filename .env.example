# Base PostgreSQL (facultative en développement : sans elle, les projets restent dans le navigateur)
DATABASE_URL="postgresql://packai:packai@localhost:5432/packai?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changez-moi-avec-openssl-rand-base64-32"
# Connexion Google (facultative)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI Images (facultatif : sans clé, les photos de la bibliothèque intégrée sont utilisées)
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Quota de la version gratuite
FREE_DESIGN_QUOTA=5
